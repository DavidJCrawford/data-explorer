---
/** The section drawing, rendered at build time (Docs/knowledge/design/the-section-drawing.md).
 *
 *  One SVG in metres (lib/section.ts). The trace's camera will move by changing
 *  the viewBox, so `viewBox` is a prop: the whole drawing by default, or any
 *  crop of it. Linework uses non-scaling strokes so a hairline stays a
 *  hairline at every zoom; text is in metres and so scales with the camera,
 *  which is what lets labels read at the trace's working zoom.
 *
 *  Nothing here is interactive. Decoration never intercepts the pointer
 *  (SPEC §7): the whole drawing is pointer-events: none, and phase 4 adds
 *  explicit hit targets on top of it.
 */
import { getCollection } from 'astro:content';
import { trace } from '@lib/knowledge';
import {
  Y, WIDTH, SLAB, FLOORS, ROOF, PLANT, CORE, RISER, ROOMS, DOOR, PROPERTY, BREAK,
  PLACES, ALSO, RACK, RECORDER, RUNS, EXTENT, ceiling, assertPlaced,
} from '@lib/section';

interface Props {
  /** [x, y, width, height] in the drawing's SVG units (metres, y down). */
  viewBox?: [number, number, number, number];
  /** Number the trace's stops. For review, and the no-JS form. */
  stops?: boolean;
  /** Draw the event's route in its own colour rather than as linework. */
  route?: boolean;
  label?: string;
  class?: string;
}

const T = await trace();
const components = (await getCollection('components')).map((c) => c.id);
assertPlaced([...components, ...T.hops.map((h) => h.component), T.sensitive.component]);

const full: [number, number, number, number] = [EXTENT.x0, Y(EXTENT.z1), EXTENT.x1 - EXTENT.x0, EXTENT.z1 - EXTENT.z0];
const { viewBox = full, stops = false, route = false, label = 'Section through the building, with the cloud above it', class: cls } = Astro.props;

const pts = (p: [number, number][]) => p.map(([x, z]) => `${x},${Y(z)}`).join(' ');
/** A rectangle from metres: x0..x1 across, z0..z1 up. */
const box = (x0: number, x1: number, z0: number, z1: number) => ({ x: x0, y: Y(z1), width: x1 - x0, height: z1 - z0 });

/* Partitions: a room's edge that is not a façade or the riser wall. */
const partitions = ROOMS.flatMap((r) => [r.x0, r.x1]
  .filter((x) => x > 0 && x < WIDTH && x !== RISER.x1)
  .map((x) => ({ x, f: FLOORS[r.floor] })));

/* The scale break: an architect's zig-zag across the drawing. */
const zig = (() => {
  const z = BREAK.z, a = 0.35, out: [number, number][] = [[PROPERTY.x0 - 1, z]];
  const mid = (PROPERTY.x0 + PROPERTY.x1) / 2;
  out.push([mid - 0.6, z], [mid - 0.3, z + a], [mid + 0.3, z - a], [mid + 0.6, z], [PROPERTY.x1 + 1, z]);
  return out;
})();

const stopAt = T.hops.map((h) => ({ n: h.n, ...PLACES[h.component] }));
---
<svg class:list={['section', cls]} viewBox={viewBox.join(' ')} role="img" aria-label={label}
     preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id="earth" width="0.8" height="0.8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="0.8" class="hatch" />
    </pattern>
    <pattern id="core" width="0.5" height="0.5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <line x1="0" y1="0" x2="0" y2="0.5" class="hatch" />
    </pattern>
  </defs>

  <!-- The ground, and the earth under it. -->
  <rect x={EXTENT.x0} y={0} width={EXTENT.x1 - EXTENT.x0} height={1.6} fill="url(#earth)" class="earth" />
  <line x1={EXTENT.x0} y1={0} x2={EXTENT.x1} y2={0} class="heavy" />

  <!-- Slabs: ground, each upper floor, and the roof. -->
  <rect {...box(-0.2, WIDTH + 0.2, -SLAB, 0)} class="slab" />
  {FLOORS.slice(1).map((f) => <rect {...box(0, WIDTH, f.z - SLAB, f.z)} class="slab" />)}
  <rect {...box(-0.2, WIDTH + 0.2, ROOF - SLAB, ROOF)} class="slab" />

  <!-- Façades, the parapet, and the door opening in the entrance façade. -->
  <polyline points={pts([[0, DOOR.z1], [0, ROOF + 1.0]])} class="wall" />
  <line x1={-0.25} y1={Y(DOOR.z1)} x2={0.25} y2={Y(DOOR.z1)} class="wall" />
  <rect {...box(-0.03, 0.03, DOOR.z0, DOOR.z1 - 0.05)} class="leaf" />
  <polyline points={pts([[WIDTH, 0], [WIDTH, ROOF + 1.0]])} class="wall" />

  <!-- Suspended ceilings, broken by the core. -->
  {FLOORS.map((f) => (
    <g class="ceiling">
      <line x1={0} y1={Y(ceiling(f))} x2={CORE.x0} y2={Y(ceiling(f))} />
      <line x1={RISER.x1} y1={Y(ceiling(f))} x2={WIDTH} y2={Y(ceiling(f))} />
    </g>
  ))}

  <!-- The core (lift and stair), hatched, running up into the plant. -->
  <rect {...box(CORE.x0, CORE.x1, 0, ROOF + 1.4)} fill="url(#core)" class="core" />
  <!-- The riser: where the building's cables run between floors. -->
  <rect {...box(RISER.x0, RISER.x1, 0, ROOF)} class="riser" />

  <!-- Partitions. -->
  {partitions.map(({ x, f }) => <line x1={x} y1={Y(f.z)} x2={x} y2={Y(ceiling(f))} class="partition" />)}

  <!-- The plant enclosure on the roof. -->
  <rect {...box(PLANT.x0, PLANT.x1, ROOF, ROOF + PLANT.h)} class="plant" />
  {[0.5, 1.0, 1.5, 2.0].map((d) => <line x1={PLANT.x1 - 3} y1={Y(ROOF + d)} x2={PLANT.x1 - 0.4} y2={Y(ROOF + d)} class="louvre" />)}

  <!-- Labels for floors and rooms. -->
  {FLOORS.map((f) => <text x={-0.6} y={Y(f.z + 0.35)} class="floor" text-anchor="end">{f.name}</text>)}
  <text x={-0.6} y={Y(ROOF + 0.35)} class="floor" text-anchor="end">Roof</text>
  {ROOMS.map((r) => <text x={r.x0 + 0.3} y={Y(ceiling(FLOORS[r.floor]) - 0.45)} class="room">{r.name}</text>)}
  <text x={RISER.x0 + 0.1} y={Y(ROOF - SLAB - 0.4)} class="room">Riser</text>

  <!-- The property line: the heaviest line in the drawing. -->
  <rect {...box(PROPERTY.x0, PROPERTY.x1, PROPERTY.z0, PROPERTY.z1)} class="property" />
  <text x={PROPERTY.x0 + 0.2} y={Y(PROPERTY.z1) - 0.3} class="property-label">Property line</text>

  <!-- The scale break. Above it, a diagram. -->
  <polyline points={pts(zig)} class="break" />
  <text x={PROPERTY.x0 + 0.2} y={Y(BREAK.z + 0.6)} class="note">Beyond this line, not to scale</text>

  <!-- Off site: the data centre, the model provider, the recipient. -->
  <g class="offsite">
    <rect {...box(8, 20, 26.6, 30)} />
    {[9.5, 11, 12.5, 15.5, 17, 18.5].map((x) => <line x1={x} y1={Y(27)} x2={x} y2={Y(29.2)} class="racks" />)}
    <rect {...box(8, 14, 37.4, 40)} />
    {[9, 10, 11, 12, 13].map((x) => <line x1={x} y1={Y(37.8)} x2={x} y2={Y(39.6)} class="racks" />)}
    <rect {...box(26, 30, 34, 36.6)} />
    <polyline points={pts([[25.6, 36.6], [28, 37.8], [30.4, 36.6]])} />
  </g>

  <!-- Conduits. The event's route, the camera's, and the rest of the building. -->
  {RUNS.map((r) => <polyline points={pts(r.points)} class:list={['run', r.stream, r.only && `only-${r.only}`, route && r.stream === 'event' && 'lit']} />)}

  <!-- Components. -->
  <g class="kit">
    <!-- Reader beside the door. -->
    <rect {...box(0.03, 0.17, 1.1, 1.32)} />
    <!-- Camera on a bracket under the ground-floor ceiling. -->
    <polyline points={pts([[1.0, ceiling(FLOORS[0])], [1.0, 3.5], [1.45, 3.4]])} class="thin" />
    <polygon points={pts([[1.0, 3.55], [1.55, 3.48], [1.55, 3.3], [1.0, 3.38]])} class="sensitive-kit" />
    <!-- Controller enclosure in the riser. -->
    <rect {...box(17.45, 18.15, 1.25, 1.95)} />
    <!-- Main switchboard, with the meter. -->
    <rect {...box(19.8, 21.1, 0, 2.1)} />
    <circle cx={20.4} cy={Y(1.5)} r={0.16} />
    <!-- FM office desk and screen. -->
    <line x1={3.2} y1={Y(FLOORS[1].z + 0.75)} x2={5.4} y2={Y(FLOORS[1].z + 0.75)} />
    <line x1={3.3} y1={Y(FLOORS[1].z + 0.75)} x2={3.3} y2={Y(FLOORS[1].z)} class="thin" />
    <line x1={5.3} y1={Y(FLOORS[1].z + 0.75)} x2={5.3} y2={Y(FLOORS[1].z)} class="thin" />
    <rect {...box(3.95, 4.5, 5.35, 5.75)} />
    <!-- Sensors: occupancy domes on ceilings, air sensors on walls. -->
    {[PLACES.occupancy, ...ALSO.filter((a) => a.component === 'occupancy')].map((p) => (
      <path d={`M ${p.x - 0.14} ${Y(p.z)} a 0.14 0.14 0 0 0 0.28 0 z`} />
    ))}
    {[PLACES.air, ...ALSO.filter((a) => a.component === 'air')].map((p) => (
      <rect x={p.x - (p.x > WIDTH / 2 ? 0.15 : 0)} y={Y(p.z + 0.12)} width={0.15} height={0.24} />
    ))}
    <!-- The rack in the comms room, with its named units. -->
    <rect {...box(RACK.x - RACK.w / 2, RACK.x + RACK.w / 2, RACK.z0, RACK.z0 + RACK.h)} />
    {[PLACES['head-end'].z, PLACES['local-ai'].z, RECORDER.z].map((z) => (
      <rect {...box(RACK.x - RACK.w / 2 + 0.05, RACK.x + RACK.w / 2 - 0.05, z - 0.09, z + 0.09)} class="unit" />
    ))}
  </g>

  <!-- Labels. -->
  {Object.entries(PLACES).map(([id, p]) => {
    const right = p.side !== 'left';
    const x = p.x + (right ? (id === 'head-end' || id === 'local-ai' ? RACK.w / 2 + 0.25 : 0.4) : -0.4);
    const anchor = right ? 'start' : 'end';
    return p.compact
      ? <text x={x} y={Y(p.z) + 0.13} text-anchor={anchor} class="label compact">{p.label}</text>
      : (
        <g>
          <text x={x} y={Y(p.z) - 0.05} text-anchor={anchor} class="label">{p.label}</text>
          <text x={x} y={Y(p.z) + 0.46} text-anchor={anchor} class="where">{p.where}</text>
        </g>
      );
  })}
  <text x={RACK.x + RACK.w / 2 + 0.25} y={Y(RECORDER.z) + 0.13} class="label compact sensitive-text">{RECORDER.label}</text>

  <!-- Whatever the page draws over the drawing: the trace's event, its
       route so far, the copies it leaves, the seams it crosses. -->
  <slot />

  {stops && stopAt.map((s) => (
    <g class="stop">
      <circle cx={s.x} cy={Y(s.z)} r={0.32} />
      <text x={s.x} y={Y(s.z) + 0.11} text-anchor="middle">{s.n}</text>
    </g>
  ))}
</svg>

<style>
  /* Every line keeps its screen width whatever the camera does. */
  .section { display: block; width: 100%; height: 100%; pointer-events: none; }
  .section :global(*) { vector-effect: non-scaling-stroke; }

  .section line, .section polyline, .section rect, .section polygon, .section path, .section circle {
    fill: none; stroke: var(--dse-drawing-heavy); stroke-width: 1;
  }
  .hatch { stroke: var(--dse-drawing) !important; stroke-width: .75 !important; }
  .earth { stroke: none !important; }
  .heavy { stroke: var(--ks-instrument-muted) !important; stroke-width: 1.25 !important; }
  .slab { fill: oklch(100% 0 0 / 0.07) !important; stroke: var(--dse-drawing-heavy) !important; }
  .wall { stroke: var(--ks-instrument-muted) !important; stroke-width: 1.5 !important; }
  .leaf { stroke: var(--dse-drawing-heavy) !important; }
  .ceiling line { stroke: var(--dse-drawing) !important; stroke-dasharray: 3 3; }
  .core { stroke: var(--dse-drawing) !important; }
  .riser { stroke: var(--dse-drawing-heavy) !important; stroke-dasharray: 1 2; }
  .partition { stroke: var(--dse-drawing-heavy) !important; }
  .plant { stroke: var(--dse-drawing-heavy) !important; }
  .louvre { stroke: var(--dse-drawing) !important; }
  .property { stroke: var(--dse-line) !important; stroke-width: 2 !important; stroke-dasharray: 10 4 2 4; }
  .break { stroke: var(--ks-instrument-muted) !important; stroke-width: 1 !important; }
  .offsite rect, .offsite polyline { stroke: var(--dse-drawing-heavy) !important; stroke-dasharray: 4 3; }
  .racks { stroke: var(--dse-drawing) !important; }

  /* Conduits. The event's route is linework until the trace travels it. */
  .run { stroke-linejoin: round; }
  .run.background { stroke: var(--dse-drawing) !important; }
  .run.event { stroke: var(--dse-drawing-heavy) !important; stroke-width: 1.25 !important; }
  .run.event.lit { stroke: var(--dse-event) !important; stroke-opacity: .7; }
  .run.sensitive { stroke: var(--dse-sensitive) !important; stroke-opacity: .55; stroke-dasharray: 2 2; }

  .kit rect, .kit circle, .kit path, .kit line, .kit polyline { stroke: var(--ks-instrument-text) !important; stroke-opacity: .8; }
  .kit .thin { stroke-opacity: .45; }
  .kit .unit { fill: oklch(100% 0 0 / 0.14) !important; }
  .kit .sensitive-kit { stroke: var(--dse-sensitive) !important; stroke-opacity: 1; }

  /* Type, in metres. At the trace's working zoom on a phone (31 px a metre)
     a label is about 14 px and the smallest text about 10 px. */
  .section text { fill: var(--ks-instrument-text); font-family: var(--ks-font), sans-serif; stroke: none; }
  .label { font-size: .46px; font-weight: 600; }
  /* The rack's units are 0.4 m apart: 0.36 m is as large as they can go. */
  .label.compact { font-size: .36px; font-weight: 500; }
  .where, .room, .floor, .note, .property-label {
    font-family: var(--ks-mono), monospace !important; letter-spacing: .06em;
    fill: var(--ks-instrument-muted) !important;
  }
  .where { font-size: .34px; }
  .room { font-size: .3px; text-transform: uppercase; }
  .floor { font-size: .34px; text-transform: uppercase; }
  .note { font-size: .3px; }
  .property-label { font-size: .34px; text-transform: uppercase; fill: var(--ks-instrument-text) !important; }
  .sensitive-text { fill: var(--dse-sensitive) !important; }

  .stop circle { fill: var(--ks-instrument-deep) !important; stroke: var(--dse-event) !important; stroke-width: 1.5 !important; }
  .stop text { font-family: var(--ks-mono), monospace; font-size: .32px; fill: var(--dse-event) !important; }
</style>
