---
/** One page per article of the Data Act, at a permanent address
 *  (/law/eu-data-act/article-4/). Both registers, the facts, the
 *  cross-references, where the article attaches on the trace, and the rights
 *  that rest on it. Everything from the article's concept. */
import type { GetStaticPaths } from 'astro';
import Reference from '@layouts/Reference.astro';
import { articles, rights, trace, actors, chapters, articleHref } from '@lib/knowledge';
import { section } from '@lib/rulebook-data';
import { longDate } from '@lib/phases';
import { PLACES } from '@lib/section';
import { u } from '@lib/url';
import { kb, DATA_ACT_ELI } from '@lib/scope';

export const getStaticPaths = (async () =>
  (await articles()).map((a) => ({ params: { slug: `article-${a.data.article}` }, props: { n: a.data.article } }))) satisfies GetStaticPaths;

const { n } = Astro.props as { n: number };
const all = await articles();
const a = all.find((x) => x.data.article === n)!;
const d = a.data;
const roles = await actors();
const ch = (await chapters()).find((c) => c.numeral === d.chapter)!;
const T = await trace();
const R = (await rights()).filter((r) => r.data.articles.includes(n));
const title = d.title.replace(/^Article \d+ — /, '');
const precise = section(a.body, 'Precise reading');
const plain = section(a.body, 'Plain reading');
const stops = T.hops.filter((h) => d.attaches_to.includes(h.component));
const alongside = d.attaches_to.filter((c) => !T.hops.some((h) => h.component === c));
const prev = all.find((x) => x.data.article === n - 1), next = all.find((x) => x.data.article === n + 1);
const applies = d.applies_from.toISOString().slice(0, 10);
---
<Reference title={`Article ${n}: ${title}`} description={plain[0]}
           eyebrow={`EU Data Act · Chapter ${ch.numeral} · ${ch.name}`}
           crumbs={[{ href: '/law/eu-data-act/', label: 'The EU Data Act' }]}
           jsonld={{ about: { '@type': 'Legislation', name: `Regulation (EU) 2023/2854, Article ${n}`, legislationIdentifier: '32023R2854', url: DATA_ACT_ELI } }}>
  <Fragment slot="head">
    <h1>Article {n}</h1>
    <p class="sub">{title}</p>
  </Fragment>

  <h2>Precise reading</h2>
  {precise.map((p) => <p>{p}</p>)}
  <p class="register">A summary of the operative demand, not the statute.</p>

  <h2>Plain reading</h2>
  {plain.map((p) => <p>{p}</p>)}
  <p class="register">Paraphrase.</p>

  <h2>Facts</h2>
  <table>
    <tbody>
      <tr><th>Applies from</th><td class="num">{longDate(applies)}</td></tr>
      <tr><th>Binds</th><td>{d.binds.length ? d.binds.map((b) => roles[b]).join(', ') : 'No party directly; structural.'}</td></tr>
      <tr><th>Cross-references</th><td>{d.cross_refs.length ? d.cross_refs.map((m, i) => <>{i > 0 && ', '}<a href={u(articleHref(m))}>Article {m}</a></>) : 'None.'}</td></tr>
      <tr><th>On the trace</th><td>{stops.length ? stops.map((h, i) => <>{i > 0 && ', '}<a href={u(`/trace/?hop=${h.n}`)}>Stop {h.n}, {PLACES[h.component].label}</a></>) : 'Not at any stop.'}{alongside.length > 0 && <>{stops.length ? '; alongside: ' : 'Alongside: '}{alongside.map((c) => PLACES[c]?.label ?? c).join(', ')}</>}</td></tr>
      <tr><th>Rights that rest on it</th><td>{R.length ? R.map((r, i) => <>{i > 0 && <br />}<a href={u(`/rights/${r.id}/`)}>{r.data.title}</a></>) : 'None of the seven.'}</td></tr>
    </tbody>
  </table>

  <p class="go"><a href={DATA_ACT_ELI} rel="noopener">The Regulation in the Official Journal</a> · <a href={kb(`law/eu-data-act/articles/article-${String(n).padStart(2, '0')}`)}>This article in the knowledge base</a></p>

  <nav class="pager" aria-label="Articles">
    <span>{prev && <a href={u(articleHref(prev.data.article))}>← Article {prev.data.article}</a>}</span>
    <span>{next && <a href={u(articleHref(next.data.article))}>Article {next.data.article} →</a>}</span>
  </nav>
</Reference>
