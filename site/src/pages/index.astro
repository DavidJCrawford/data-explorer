---
/** A holding page until phase 2 builds the landing page (SPEC §4.1). It is in
 *  the landing page's shape already, and every number on it is computed from
 *  the knowledge base, so it proves the collections are wired end to end. */
import Base from '@layouts/Base.astro';
import { SITE_NAME } from '@lib/scope';
import { articles, rights, totals } from '@lib/knowledge';

const A = await articles();
const R = await rights();
const T = await totals();
---
<Base title={SITE_NAME}>
  <div class="wrap section hero">
    <p class="eyebrow">Connected buildings · EU Data Act</p>
    <h1 class="display" style="margin-top:.2em">{SITE_NAME}</h1>
    <p class="lead" style="margin-top:1.2em">
      Where a building’s data goes, who holds it at each step, and what the law says its owner is owed there.
      The site is being built.
    </p>
  </div>

  <div class="wrap">
    <hr class="rule" />
    <div class="stats">
      <div class="stat"><div class="eyebrow">Hops from the door</div><div class="value num">{T.hops}</div></div>
      <div class="stat"><div class="eyebrow">Copies made</div><div class="value num">{T.composite.copies}</div></div>
      <div class="stat"><div class="eyebrow">Hands, composite / governed</div><div class="value num">{T.composite.hands} / {T.governed.hands}</div></div>
      <div class="stat"><div class="eyebrow">Data Act articles</div><div class="value num">{A.length}</div></div>
      <div class="stat"><div class="eyebrow">Rights</div><div class="value num">{R.length}</div></div>
    </div>
    <hr class="rule" />
  </div>
</Base>

<style>
  .hero { padding-block: clamp(20px, 3.6vh, 72px) clamp(24px, 3.4vh, 64px); }
  .hero .display { font-size: clamp(2.6rem, min(6vw, 8.6vh), var(--ks-type-display-size)); }
  .hero .lead { max-width: 50em; text-wrap: pretty; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: clamp(18px, 3vw, 40px); padding-block: clamp(16px, 2.6vh, 26px); }
  .stat .value { font-size: clamp(1.15rem, 1.6vw, var(--ks-type-title-lg-size)); font-weight: 300; color: var(--ks-ink); line-height: 1.2; margin-top: 2px; }
</style>
